# ============================================================
# Dockerfile.frontend —— 前端镜像（多阶段构建）
# ============================================================
#
# 阶段一（build）：Node 环境把 Vue 源代码编译成静态文件。
# 阶段二（runtime）：Nginx 托管这些静态文件，并反向代理 API 请求给后端。
#
# 为什么要分两个阶段？
# 最终镜像只需要 Nginx + 静态文件（几十 MB），
# 如果保留 Node 环境（几百 MB）会白白浪费磁盘和带宽。

# ---- 阶段一：构建 ----
FROM node:20-alpine AS build

WORKDIR /app

# 先复制 package.json 和锁文件并安装依赖，利用 Docker 缓存加速。
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# 再复制全部前端源码，执行打包。
COPY frontend/ ./
RUN npm run build

# ---- 阶段二：运行 ----
FROM nginx:alpine

# 把构建产物放到 Nginx 的网页根目录。
COPY --from=build /app/dist /usr/share/nginx/html

# 用我们自己的配置替换 Nginx 默认配置（默认配置只托管静态文件，不会反向代理）。
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80