# 在 DeepSeek 开放平台创建 API Key，然后粘贴到等号右侧。
# 不要加引号，也不要把真正的 Key 提交到 Git。
DEEPSEEK_API_KEY=

# 可选：不写这一行时，程序默认使用 deepseek-flash。
DEEPSEEK_MODEL=deepseek-flash

# ---- 数据库配置（PostgreSQL + pgvector）----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=ai_agent

# ---- 智谱 embedding（RAG 向量检索）----
ZHIPU_API_KEY=
ZHIPU_MODEL=embedding-3
